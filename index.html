  main{padding:18px 0 8px}
  #list{display:flex;flex-direction:column;gap:12px}
  .card{
    background:var(--panel);border:1px solid var(--line);border-left:3px solid var(--line);
    border-radius:12px;padding:15px 16px;
  }
  .card.is-low{border-left-color:var(--green)}
  .card.is-above{border-left-color:var(--amber)}
  .head{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 10px;margin-bottom:10px}
  .name{margin:0;font-size:16.5px;font-weight:650;line-height:1.35;overflow-wrap:anywhere}
  .name mark{background:rgba(61,220,132,.22);color:var(--green);border-radius:3px;padding:0 2px}
  .en{color:var(--dim);font-size:12.5px;overflow-wrap:anywhere}
  .tag{
    margin-left:auto;font-size:12.5px;font-weight:600;border-radius:999px;
    padding:3px 10px;white-space:nowrap;
  }
  .tag.low{color:var(--green);background:rgba(61,220,132,.12)}
  .tag.above{color:var(--amber);background:rgba(245,184,61,.12)}
