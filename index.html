    .date{font-size:10.5px}
    .tag{margin-left:0;font-size:12px}
    #q{font-size:16px;padding:13px 44px 13px 13px}
    .card{padding:13px 12px}
  }
  @media (max-width:360px){
    .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .grid .cell:last-child{grid-column:span 2}
  }
</style>
</head>
