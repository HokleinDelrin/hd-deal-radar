  .cell{background:var(--panel2);border-radius:9px;padding:9px 11px;min-width:0}
  .k{display:block;color:var(--dim);font-size:11.5px;letter-spacing:.02em;margin-bottom:2px}
  .v{display:block;font-size:18px;font-weight:700;letter-spacing:-.01em;font-variant-numeric:tabular-nums}
  .v.low{color:var(--green)}
  .v.above{color:var(--amber)}
  .v.zero{color:var(--green)}
  .date{display:block;color:var(--muted);font-size:11.5px;margin-top:2px}
  .foot{margin:10px 0 0;color:var(--dim);font-size:12.5px;overflow-wrap:anywhere}
  .foot .wait{color:var(--muted)}
  .empty{color:var(--muted);padding:26px 4px;font-size:14.5px;line-height:1.7}
  .empty code{background:var(--panel2);padding:1px 5px;border-radius:4px;color:var(--blue)}
  .more{color:var(--dim);font-size:13px;padding:12px 2px 2px}
  footer{border-top:1px solid var(--line);margin-top:22px;padding:22px 0 42px;color:var(--muted);font-size:13px;line-height:1.75}
  footer p{margin:0 0 8px}
  footer .ph{color:var(--amber)}
  footer .note{color:var(--dim);font-size:12px}
  @media (max-width:560px){
