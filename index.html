const el = (id) => document.getElementById(id);
const listEl = el('list'), moreEl = el('more'), qEl = el('q'), clearEl = el('clear');

function esc(s){
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function money(n){
  const s = (Math.round(n * 100) / 100).toFixed(2).replace(/\.00$/, '');
  return '¥' + s;
}
function reviewText(n){
  if (!n) return null;
  return n >= 10000 ? (n / 10000).toFixed(1).replace(/\.0$/, '') + ' 万' : String(n);
}
// 匹配：中文名 / 英文名 / appid / 开发商
function match(g, kw){
  if (!kw) return true;
  const k = kw.toLowerCase().trim();
  return g.cn.toLowerCase().includes(k) || (g.name || '').toLowerCase().includes(k)
       || String(g.appid).includes(k) || (g.year || '') === k;
}
function highlight(text, kw){
  const safe = esc(text);
  if (!kw) return safe;
  const k = kw.trim();
  if (!k) return safe;
  const i = text.toLowerCase().indexOf(k.toLowerCase());
  if (i < 0) return safe;
  return esc(text.slice(0, i)) + '<mark>' + esc(text.slice(i, i + k.length)) + '</mark>' + esc(text.slice(i + k.length));
}

function card(g, kw){
  const atLow = g.now <= g.low + 0.005;
  const diff = atLow ? 0 : (g.now / g.low - 1) * 100;
  const cls = atLow ? 'is-low' : 'is-above';
  const date = g.low_date ? g.low_date : '小黑盒口径 · 无日期';
  const bits = [];
  if (g.list && g.list > g.now + 0.005) bits.push('原价 ' + money(g.list));
  if (g.discount) bits.push('-' + g.discount + '%');
  const rv = reviewText(g.reviews);
  if (rv) bits.push('评论 ' + rv);
  bits.push('本机快照 ' + g.snaps + ' 条');
  const advice = atLow ? '已经是史低' : '等回 ' + money(g.low);
  return '<article class="card ' + cls + '">'
    + '<div class="head">'
    +   '<h2 class="name">' + highlight(g.cn, kw) + (g.name && g.name !== g.cn ? ' <span class="en">' + highlight(g.name, kw) + '</span>' : '') + '</h2>'
    +   '<span class="tag ' + (atLow ? 'low' : 'above') + '">' + (atLow ? '现在就是史低' : '还比史低贵 ' + diff.toFixed(0) + '%') + '</span>'
    + '</div>'
    + '<div class="grid">'
    +   '<div class="cell"><span class="k">当前价</span><span class="v">' + money(g.now) + '</span><span class="date">Steam 国区</span></div>'
    +   '<div class="cell"><span class="k">史低</span><span class="v low">' + money(g.low) + '</span><span class="date">' + esc(date) + '</span></div>'
    +   '<div class="cell"><span class="k">比史低贵</span><span class="v ' + (atLow ? 'zero' : 'above') + '">' + (atLow ? '0%' : '+' + diff.toFixed(1) + '%') + '</span><span class="date">' + esc(advice) + '</span></div>'
    + '</div>'
    + '<p class="foot">' + esc(bits.join(' · ')) + '</p>'
    + '</article>';
}

function render(){
  const kw = qEl.value.trim();
  clearEl.classList.toggle('on', !!kw);
  const hits = GAMES.filter(g => match(g, kw));
  const show = kw ? hits.slice(0, 40) : hits.slice(0, 8);
  if (!hits.length){
    listEl.innerHTML = '<p class="empty">没搜到「' + esc(kw) + '」。<br>内嵌数据只有 <code>' + GAMES.length + '</code> 条（这台机器上真采到价的游戏），换个名字试试。</p>';
    moreEl.textContent = '';
    return;
  }
  listEl.innerHTML = show.map(g => card(g, kw)).join('');
  if (hits.length > show.length){
    moreEl.textContent = kw
      ? '还有 ' + (hits.length - show.length) + ' 条匹配，把名字打全一点能缩到几条。'
      : '默认只显示 8 条（现在就是史低的优先）。输入名字看你要的那个，共 ' + hits.length + ' 条。';
  } else {
    moreEl.textContent = kw ? '共 ' + hits.length + ' 条匹配' : '';
  }
}

// 点开就能玩：给几个一定存在的例子
const CHIPS = ['艾尔登法环', '深空当铺', '冰汽时代', '无主之地2', '人类一败涂地', 'PEAK'];
function initChips(){
  el('chips').innerHTML = CHIPS.map(c => '<button class="chip" type="button">' + esc(c) + '</button>').join('');
  el('chips').addEventListener('click', e => {
    const b = e.target.closest('.chip');
    if (!b) return;
    qEl.value = b.textContent;
    render();
    qEl.focus();
  });
}

// 排序：现在就是史低的优先 → 评论多（认得出来的）优先 → 折扣大的优先
GAMES.sort((a, b) => {
  const la = a.now <= a.low + 0.005 ? 0 : 1, lb = b.now <= b.low + 0.005 ? 0 : 1;
  if (la !== lb) return la - lb;
  if ((b.reviews || 0) !== (a.reviews || 0)) return (b.reviews || 0) - (a.reviews || 0);
  return (b.discount || 0) - (a.discount || 0);
});

el('total').textContent = GAMES.length;
initChips();
qEl.addEventListener('input', render);
clearEl.addEventListener('click', () => { qEl.value = ''; render(); qEl.focus(); });
qEl.addEventListener('keydown', e => { if (e.key === 'Escape'){ qEl.value = ''; render(); } });

// 支持 #q=名字 直接进入某个搜索结果（截图 / 分享用）
const hq = new URLSearchParams(location.hash.slice(1)).get('q');
if (hq) qEl.value = hq;
render();
</script>
